{
  "name": "dsh-notes-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sticky-notes wall panel with pin, star, one-click delete, six paper tints and always-on-top desktop notes.",
  "author": "zenmokandouhenshuai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenmokandouhenshuai/dsh-notes-wall.git"
  },
  "homepage": "https://github.com/zenmokandouhenshuai/dsh-notes-wall#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sticky-notes",
    "notes",
    "widget"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "widget.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
